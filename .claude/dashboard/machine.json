{
  "$comment": "Machine page checks, from the catalog in dashboard/server/src/machine-catalog.ts. Schema: references/config.md.",
  "checks": [
    {
      "use": "package-manager"
    },
    {
      "use": "node",
      "required": {
        "file": "plugins/natterjack/engine/package.json",
        "regex": "\"node\":\\s*\">=([\\d.]+)\"",
        "min": "24.22.0"
      }
    },
    {
      "use": "git"
    },
    {
      "use": "gh"
    },
    {
      "use": "claude"
    },
    {
      "use": "path",
      "id": "engine-deps",
      "label": "engine dependencies",
      "path": "plugins/natterjack/engine/node_modules",
      "install": {
        "label": "npm ci",
        "win": "npm ci",
        "mac": "npm ci",
        "linux": "npm ci",
        "cwd": "plugins/natterjack/engine"
      },
      "apps": [
        "ui-dev"
      ]
    },
    {
      "use": "path",
      "id": "dashboard-link",
      "label": "dashboard/ linked to the engine",
      "path": "dashboard/server/src/main.ts",
      "fix": {
        "win": "cmd /c mklink /J dashboard plugins\\natterjack\\engine",
        "mac": "ln -s plugins/natterjack/engine dashboard",
        "linux": "ln -s plugins/natterjack/engine dashboard"
      }
    },
    {
      "use": "claude-plugin",
      "id": "multirepo-plugin",
      "label": "multirepo plugin",
      "plugin": "multirepo@lhoezee-skills",
      "marketplace": "lhoezee/skills",
      "optional": true,
      "group": "Optional",
      "when": {
        "access": "full"
      },
      "detail": {
        "ok": "Implement on the Issues page can run /multirepo:implement."
      }
    },
    {
      "use": "gcloud",
      "optional": true,
      "group": "Optional"
    },
    {
      "use": "docker",
      "optional": true,
      "group": "Optional",
      "detail": {
        "ok": "Builds the hosted image (templates/hosted/Dockerfile).",
        "missing": "Only needed to build the hosted image."
      }
    }
  ]
}
